{
  "expo": {
    "name": "SpotifyPlaylists",
    "slug": "spotifyplaylists",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "spotifyplaylists",
    "android": {
      "package": "com.spotifyplaylists.app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
